<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

    <ImageButton
        android:id="@+id/button_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="22dp"
        android:background="@drawable/settings_button_background"
        android:contentDescription="@string/launcher_vr_settings"
        android:padding="15dp"
        android:src="@drawable/ic_settings_fzero" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="40dp"
        android:paddingEnd="36dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/launcher_title"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/launcher_subtitle"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:background="@drawable/launcher_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_rom_label"
                android:textAllCaps="true"
                android:textColor="@color/launcher_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_rom_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_rom_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/button_choose_rom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/outline_button_background"
                android:text="@string/launcher_choose_rom"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/button_change_rom"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="@string/launcher_change_rom"
                android:textAllCaps="false"
                android:textColor="@color/launcher_accent_light"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/button_launch"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/primary_button_background"
            android:text="@string/launcher_play"
            android:textAllCaps="false"
            android:textColor="#10241E"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/launcher_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
