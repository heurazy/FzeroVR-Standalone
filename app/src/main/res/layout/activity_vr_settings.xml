<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/button_back_settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="@string/settings_back"
            android:textAllCaps="false"
            android:textColor="@color/launcher_accent_light"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/settings_title"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/launcher_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_refresh_label"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_refresh_description"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/refresh_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/refresh_72"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/launcher_accent_light"
                    android:text="72 Hz"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/refresh_80"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/launcher_accent_light"
                    android:text="80 Hz"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/refresh_90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/launcher_accent_light"
                    android:text="90 Hz"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/refresh_120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/launcher_accent_light"
                    android:text="120 Hz"
                    android:textColor="@android:color/white" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/launcher_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <Switch
                android:id="@+id/switch_start_diorama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_start_diorama"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:thumbTint="@color/launcher_accent_light"
                android:trackTint="@color/launcher_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_start_diorama_description"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_save_settings"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/primary_button_background"
            android:text="@string/settings_save"
            android:textAllCaps="false"
            android:textColor="#10241E"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
